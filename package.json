  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "find game web worker scripts tests -type f \\( -name '*.js' -o -name '*.mjs' \\) -exec sh -c 'for file do node --check \"$file\" || exit; done' sh {} + && node --check playwright.config.js",
    "test": "vitest run",
    "test:browser": "playwright test --project=webkit"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "vite": "8.4.0",
    "vitest": "5.1.2",
    "wrangler": "4.168.0"
  },
